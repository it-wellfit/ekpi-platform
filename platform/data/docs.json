    {
      "doc_id": "QM-01",
      "title": "品質手冊",
      "versions": [
        {
          "version": "2.1",
          "effective_from": "2025-01-01",
          "effective_to": "2025-09-30",
          "injection_directive": null,
          "sections": [
            {
              "section": "2.4",
              "page": 3,
              "verbatim_text": "品質手冊一般條款：所有作業應遵循版本化文件與核准流程。"
            }
          ]
        },
        {
          "version": "5.0",
          "effective_from": "2025-10-01",
          "effective_to": null,
          "injection_directive": null,
          "sections": [
            {
              "section": "2.4",
              "page": 4,
              "verbatim_text": "採購申請一經受理即視為取得執行許可；各單位得依受理時點執行後續作業。"
            }
          ]
        }
      ]
    },
    {
      "doc_id": "EX-7",
      "title": "例外條款第 7 號",
      "versions": [
        {
          "version": "2.0",
          "effective_from": "2025-01-01",
          "effective_to": null,
          "injection_directive": null,
          "sections": [
            {
              "section": "7.2",
              "page": 1,
              "verbatim_text": "經部門主管核准且屬無 QMS 影響的變更，得免除品質經理複核。"
            }
          ]
        }
      ]
    },
    {
      "doc_id": "SOP-CAPA",
      "title": "CAPA 作業 SOP",
      "versions": [
        {
          "version": "1.4",
          "effective_from": "2025-04-01",
          "effective_to": null,
          "injection_directive": null,
          "sections": [
            {
              "section": "6.1",
              "page": 8,
              "verbatim_text": "矯正措施驗證未通過時，得回退至 REWORK 階段重新執行矯正措施。"
            },
            {
              "section": "6.2",
              "page": 9,
              "verbatim_text": "驗證失敗累計達三次（含）以上者，必須停止回退循環並升級人工裁定。"
            }
          ]
        }
      ]
    },
    {
      "doc_id": "SOP-PURCH",
      "title": "採購 SOP",
      "versions": [
        {
          "version": "4.4",
          "effective_from": "2025-10-01",
          "effective_to": null,
          "injection_directive": null,
          "sections": [
            {
              "section": "3.1",
              "page": 5,
              "verbatim_text": "採購金額達新臺幣壹佰萬元以上者，須依簽核流程取得主管核准後始得下單執行。"
            }
          ]
        },
        {
          "version": "4.5",
          "effective_from": "2026-06-01",
          "effective_to": null,
          "injection_directive": null,
          "sections": [
            {
              "section": "3.1",
              "page": 5,
              "verbatim_text": "付款單簽核依本節辦理；主管雙簽為原則，例外依第 3.2 節。"
            },
            {
              "section": "3.2",
              "page": 6,
              "verbatim_text": "小額（未達新臺幣壹拾萬元）付款得單簽辦理，優先於原則性條款。"
            },
            {
              "section": "3.3",
              "page": 6,
              "verbatim_text": "付款一律須經副總簽核，不因金額大小而免除。"
            },
            {
              "section": "3.4",
              "page": 7,
              "verbatim_text": "所有付款單皆須主管親筆簽名。"
            },
            {
              "section": "3.5",
              "page": 7,
              "verbatim_text": "合格電子簽章視同親筆簽名。"
            }
          ]
        }
      ]
    },
    {
      "doc_id": "SOP-REL",
      "title": "變更核准執行時限 SOP",
      "versions": [
        {
          "version": "1.0",
          "effective_from": "2026-03-01",
          "effective_to": null,
          "injection_directive": null,
          "sections": [
            {
              "section": "2.1",
              "page": 5,
              "verbatim_text": "變更核准完成後，應於 2 個工作日內完成執行；逾期之處置準則見第 2.2 節與併行機制。"
            },
            {
              "section": "2.2",
              "page": 6,
              "verbatim_text": "逾期的變更執行，視其治理分類自動升級品質經理人工裁定。"
            },
            {
              "section": "3.1",
              "page": 9,
              "verbatim_text": "本 SOP 之第 2 節規定適用至 2026-06-30；屆期後另行公告。"
            }
          ]
        }
      ]
    },
    {
      "doc_id": "SOP-CLOSE",
      "title": "變更關閉管控 SOP",
      "versions": [
        {
          "version": "1.0",
          "effective_from": "2026-03-01",
          "effective_to": null,
          "injection_directive": null,
          "sections": [
            {
              "section": "3.1",
              "page": 4,
              "verbatim_text": "變更關閉後，除經主管重新開案登記者外，不得再執行任何變更作業。"
            }
          ]
        }
      ]
    }
  ]
