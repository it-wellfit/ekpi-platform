# EKPI environment variable placeholders (copy to `.env`, never commit real values)

# Core platform (local-only; all optional)
EKP_DATA_DIR=./platform/data
EKP_CONFIG_DIR=./platform/config
EKP_OUT_DIR=./platform/out

# Eval harness
EKP_EVAL_CASES_DIR=./eval/cases
EKP_EVAL_OUT_DIR=./eval/report_out

# Governance web prototype (local-only)
EKP_GOVERNANCE_DATA=%LOCALAPPDATA%\EKPI\governance-ledger.jsonl

# Secrets placeholders — DO NOT fill with real values here
# EKP_API_KEY=
# EKP_DB_URL=
# EKP_SECRET_TOKEN=